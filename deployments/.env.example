# Copy to deployments/.env on the VPS and edit. Never commit the real .env.

# --- public ingress (Caddy, automatic TLS) ---
DOMAIN=embeddings.ngamia.cc
ACME_EMAIL=you@example.com
# Space-separated CIDRs allowed to call /admin/* (nothing else can).
# e.g. "127.0.0.1/32 41.90.0.0/16"
ADMIN_ALLOW_CIDRS=127.0.0.1/32

# --- secrets (required) ---
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
ADMIN_TOKEN=change-me

# --- database ---
POSTGRES_USER=embeddings
POSTGRES_DB=embeddings

# --- engine image: pin a llama.cpp build made after 2026-10-06 (PR 30054) ---
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# Preferred: pin by digest
# LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:<digest>

# --- model files inside ../models (see models/MANIFEST.sha256) ---
TEXT_MODEL=embeddinggemma-2-BF16.gguf
MMPROJ=mmproj-embeddinggemma-2-BF16.gguf

# --- engine sizing: -c must equal CONTEXT_SIZE; slots split the context ---
ENGINE_SLOTS=2
CONTEXT_SIZE=8192
BATCH_SIZE=4096

# --- gateway ---
GATEWAY_PORT=8090
MEDIA_CONCURRENCY=1
MAX_ITEM_TOKENS=4096
MAX_BODY_BYTES=26214400
MEDIA_BYTES_BUDGET=134217728
VIDEO_ENABLED=false
LOG_LEVEL=info

# --- video engine (Phase 8, Path B): only used when VIDEO_ENABLED=true ---
# Start it with:  docker compose --profile video up -d
# First start downloads weights into the hfmodels volume (several GB).
EMBED_PY_MODEL=google/embeddinggemma-2
EMBED_PY_BF16=false
EMBED_PY_BATCH_SIZE=4
EMBED_PY_THREADS=0
VIDEO_FRAMES_PER_SECOND=1
VIDEO_MAX_SECONDS=58
VIDEO_MAX_BYTES=67108864
VIDEO_TIMEOUT=300s
